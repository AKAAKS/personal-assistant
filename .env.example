# Anthropic API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Home Assistant configuration
HA_URL=http://localhost:8123
HA_TOKEN=your-home-assistant-long-lived-access-token-here

# Spotify — create an app at https://developer.spotify.com/dashboard
# Set the redirect URI to http://127.0.0.1:8888/callback in your Spotify app settings
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Android TV — enable developer mode and ADB debugging on your TV
# Find the TV's IP in Settings > Network & Internet > (your connection)
ANDROID_TV_IP=192.168.1.100

# Google (Gmail read+draft, Calendar) — optional
# One-time setup:
#   1. Create a project at https://console.cloud.google.com/
#   2. Enable the Gmail API and the Google Calendar API
#   3. Configure the OAuth consent screen (External, "Testing" mode; add your
#      own Google account as a test user)
#   4. Create an OAuth client ID of type "Desktop app"; download the client
#      secrets JSON
#   5. Point GOOGLE_CREDENTIALS_FILE at that file. First daemon start opens a
#      browser once for consent; the token is cached at data/google_token.json.
# Scopes are minimal: gmail.readonly + gmail.compose (drafts only, NEVER sends)
# and calendar (read + create/delete events).
# GOOGLE_CREDENTIALS_FILE=C:\path\to\client_secret.json

# Router / cost management
# MONTHLY_BUDGET=20
# OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
# SEARCH_MONTHLY_CAP=100          # max web searches/month (~$0.01 each); cap hit -> search tool is dropped, rest of JARVIS keeps working

# Files — search_files/read_document/run_script
# FILE_ROOTS=~/Documents;~/Projects;~/Downloads   # semicolon-separated allowlist for search_files/read_document
# JARVIS_SCRIPTS_DIR=scripts/jarvis_approved       # only scripts inside this folder can ever be run by run_script

# PC terminal control (Tier A open_terminal / Tier B run_command)
# JARVIS_ALLOW_SHELL=1   # set to 0 to fully disable open_terminal + run_command.
# Headless commands are denylist-sanitized (security/command_sanitizer.py — blocks
# disk format/wipe, recursive mass-delete, registry deletion, download-and-execute,
# raw shutdown) AND require explicit confirmation (run_command is destructive-tier).
# Restart/shutdown go through system_power, which runs WITHOUT force so each app
# shows its own save prompt.

# Voice pipeline (used with --voice flag)
# WAKE_WORD_MODEL=hey_jarvis_v0.1
# WAKE_WORD_THRESHOLD=0.5
# WHISPER_MODEL=small
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=int8_float16
# Reject low-confidence transcriptions so noise/echo becomes silence instead of
# invented words. Raise NO_SPEECH toward 1.0 or LOGPROB toward 0 to be stricter.
# WHISPER_NO_SPEECH_THRESHOLD=0.6
# WHISPER_LOGPROB_THRESHOLD=-1.0
# TTS_RATE=180
# VAD_AGGRESSIVENESS=2

# Hands-free follow-up: after a reply, JARVIS keeps listening this many seconds
# for a follow-up without the wake word. If media plays on your speakers it can
# bleed into this window and loop — set to 0 to require "hey jarvis" each turn
# (fully stops media-driven loops), or just use headphones.
# FOLLOWUP_WINDOW_SEC=6
# MAX_FOLLOWUP_MISFIRES=2

# TTS backend — pyttsx3 (offline, default) or edge (free Microsoft neural voices, needs network)
# TTS_BACKEND=pyttsx3   # or: edge
# EDGE_TTS_VOICE=en-US-GuyNeural

# Habit suggestions — nightly mining of logs/audit.jsonl into proposed profile facts
# HABIT_SCAN_HOUR=3

# Location & weather
# JARVIS wants your location so it can answer weather / "near me" without asking.
# Primary source is the Windows Location API (precise GPS, requested at HIGH
# accuracy) — turn it on at Settings > Privacy & security > Location > "Let
# desktop apps access your location". Coordinates are reverse-geocoded to a
# street-level place name via OpenStreetMap.
# Your home base: set NAME to your actual street address so "home" is always
# right regardless of where the laptop is; LAT/LON double as the GPS fallback.
# JARVIS_HOME_LAT=43.6532
# JARVIS_HOME_LON=-79.3832
# JARVIS_HOME_NAME=123 Main St, Toronto
# Units for weather (metric = °C/km·h, imperial = °F/mph). Default: metric.
# JARVIS_UNITS=metric
