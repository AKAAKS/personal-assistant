# Anthropic API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Home Assistant configuration
HA_URL=http://localhost:8123
HA_TOKEN=your-home-assistant-long-lived-access-token-here

# Spotify — create an app at https://developer.spotify.com/dashboard
# Set the redirect URI to http://127.0.0.1:8888/callback in your Spotify app settings
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Android TV — enable developer mode and ADB debugging on your TV
# Find the TV's IP in Settings > Network & Internet > (your connection)
ANDROID_TV_IP=192.168.1.100

# Google (Gmail read+draft, Calendar) — optional
# One-time setup:
#   1. Create a project at https://console.cloud.google.com/
#   2. Enable the Gmail API and the Google Calendar API
#   3. Configure the OAuth consent screen (External, "Testing" mode; add your
#      own Google account as a test user)
#   4. Create an OAuth client ID of type "Desktop app"; download the client
#      secrets JSON
#   5. Point GOOGLE_CREDENTIALS_FILE at that file. First daemon start opens a
#      browser once for consent; the token is cached at data/google_token.json.
# Scopes are minimal: gmail.readonly + gmail.compose (drafts only, NEVER sends)
# and calendar (read + create/delete events).
# GOOGLE_CREDENTIALS_FILE=C:\path\to\client_secret.json

# Turso / libSQL (Macro Chef shared store) — optional, for the future PWA phase.
# Create a DB + token at https://app.turso.tech (or the `turso` CLI). JARVIS keeps
# a fast local embedded replica that syncs to this cloud DB. Unset = pure local
# SQLite (data/jarvis.db), which is the default and needs no account.
# TURSO_DATABASE_URL=libsql://macro-chef-<your-org>.turso.io
# TURSO_AUTH_TOKEN=your-turso-database-auth-token-here

# Router / cost management
# MONTHLY_BUDGET=20
# OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
# SEARCH_MONTHLY_CAP=100          # max web searches/month (~$0.01 each); cap hit -> search tool is dropped, rest of JARVIS keeps working

# Files — search_files/read_document/run_script
# FILE_ROOTS=~/Documents;~/Projects;~/Downloads   # semicolon-separated allowlist for search_files/read_document
# JARVIS_SCRIPTS_DIR=scripts/jarvis_approved       # only scripts inside this folder can ever be run by run_script

# PC terminal control (Tier A open_terminal / Tier B run_command)
# JARVIS_ALLOW_SHELL=1   # set to 0 to fully disable open_terminal + run_command.
# Headless commands are denylist-sanitized (security/command_sanitizer.py — blocks
# disk format/wipe, recursive mass-delete, registry deletion, download-and-execute,
# raw shutdown) AND require explicit confirmation (run_command is destructive-tier).
# Restart/shutdown go through system_power, which runs WITHOUT force so each app
# shows its own save prompt.

# Voice pipeline (used with --voice flag)
# WAKE_WORD_MODEL=hey_jarvis_v0.1
# WAKE_WORD_THRESHOLD=0.5
# distil-large-v3 at float16 needs ~1.5GB VRAM and is far better on proper
# nouns than "small" (which turned "terminal" into "domino" and "Claude" into
# "flawed code"). Drop to "medium" or "small" if VRAM or latency is tight.
# WHISPER_MODEL=distil-large-v3
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16
# Reject low-confidence transcriptions so noise/echo becomes silence instead of
# invented words. Raise NO_SPEECH toward 1.0 or LOGPROB toward 0 to be stricter.
# WHISPER_NO_SPEECH_THRESHOLD=0.6
# WHISPER_LOGPROB_THRESHOLD=-1.0
# Seed the decoder with the vocabulary of this house (device names, "Claude",
# "terminal", ...) so it stops guessing ordinary English. Set empty to disable.
# WHISPER_INITIAL_PROMPT=
# voice/audio_io.py has already VAD-trimmed the clip; letting Whisper trim it
# AGAIN ate the onset of the first word. Set to 1 only if noise gets through.
# WHISPER_VAD_FILTER=0
# TTS_RATE=180
# VAD_AGGRESSIVENESS=2

# Speaker verification — JARVIS responds ONLY to your enrolled voice (rejects
# its own TTS echo and random triggers). Enroll once: python -m clients.enroll_voice
# Active automatically once data/voiceprint.npy exists. Set SPEAKER_VERIFY=0 to
# force it off.
#
# Enrollment WRITES the threshold and margin to data/verify_config.json, derived
# from the measured gap between your voice and JARVIS's. You should not need to
# set either by hand; these env vars override the file if you do.
#   threshold -- minimum absolute similarity to your voiceprint.
#   margin    -- how far your score must beat the score against JARVIS's own
#                voice. This is what actually stops the feedback loop, and it
#                holds up even when absolute scores drift with mic or distance.
# SPEAKER_VERIFY=1
# SPEAKER_VERIFY_BACKEND=ecapa     # or: resemblyzer (fallback)
# SPEAKER_VERIFY_THRESHOLD=0.60
# SPEAKER_VERIFY_MARGIN=0.10
# Clips shorter than this skip the absolute threshold (the embedding is too
# noisy to trust) and are decided by the margin rule alone.
# SPEAKER_VERIFY_MIN_DURATION_SEC=1.2

# Bluetooth / output latency. winsound gives no playback-completion callback,
# so the client infers the end of a reply from the WAV header — a clock that
# starts when PlaySound RETURNS, not when sound reaches the speaker. Set this
# too low and JARVIS stops its own reply mid-sentence, then hears the delayed
# tail as your next turn. MEASURE YOURS: python scripts/voice_calibrate.py
# OUTPUT_LATENCY_MS=250
# WATCH_TAIL_MS=150          # slop past the computed end of playout
# ECHO_DRAIN_MS=250          # mic frames discarded after a reply finishes
# A capture must hold at least this much VAD-positive audio to count as an
# utterance. Total length can't tell a command from a noise blip: with 800ms of
# trailing silence appended, a 1.0s "utterance" is ~0.2s of room noise. Raise it
# if the follow-up window keeps latching onto noise; lower it if short commands
# ("lights off") get dropped. A blip is discarded and listening CONTINUES, so
# this never cuts the follow-up window short.
# MIN_SPEECH_MS=300
# Audio kept from BEFORE the VAD latched, so soft word onsets aren't clipped.
# PRE_ROLL_MS=300

# Barge-in while a reply is playing. The mic also hears JARVIS, so the idle
# wake-word threshold is the wrong bar: a hit must be more confident, louder
# than the running echo floor, and sustained across chunks.
# These default to the SAME score and streak as idle listening. An earlier
# version demanded 0.7 over two chunks, which made interrupting JARVIS harder
# than waking it and stopped barge-in firing at all.
# WAKE_WORD_THRESHOLD_PLAYBACK=0.5
# WAKE_WORD_CONSECUTIVE_PLAYBACK=1
# The loudness gate is OFF by default (0). Measured: it rejected every genuine
# barge-in attempt at scores of 0.97-1.00. The self-fire it guarded against was
# never observed, and is now harmless anyway (a self-fire purges, records the
# echo, and has it dropped as `unverified`). Set ~1.2 to re-enable: you must
# then be that much louder at the mic than JARVIS's echo. It compares the
# LOUDEST chunk in the last ~1.5s, because openwakeword's score spans that
# window while a single 80ms chunk does not -- the detection lands on the quiet
# pause after the wake phrase, so comparing one chunk could never pass.
# PLAYBACK_LEVEL_RATIO=0
# PLAYBACK_MIN_LEVEL=200           # absolute RMS floor when the gate is on
# PLAYBACK_LEVEL_WINDOW_CHUNKS=19  # ~1.5s, matching the model's receptive field
# PLAYBACK_DIAG_SCORE=0.3          # log near-miss barge-ins scoring at least this

# Hands-free follow-up: after a reply, JARVIS keeps listening this many seconds
# for a follow-up without the wake word. If media plays on your speakers it can
# bleed into this window and loop — set to 0 to require "hey jarvis" each turn
# (fully stops media-driven loops), or just use headphones.
# FOLLOWUP_WINDOW_SEC=6
# MAX_FOLLOWUP_MISFIRES=2
# Utterances rejected as "not the enrolled speaker" are usually JARVIS's own
# echo. They are ignored silently rather than counted as misfires (being told
# "didn't catch that" because the assistant heard itself was the bug), but this
# many in a row still ends the conversation so a noisy room terminates.
# MAX_UNVERIFIED=4

# TTS backend — pyttsx3 (offline, default) or edge (free Microsoft neural voices, needs network)
# TTS_BACKEND=pyttsx3   # or: edge
# EDGE_TTS_VOICE=en-US-GuyNeural

# Daemon address. The client defaults match these, so change both or neither.
# JARVIS_HOST=127.0.0.1
# JARVIS_PORT=8765
# JARVIS_URL=ws://127.0.0.1:8765   # used by the CLI and voice clients
# JARVIS_DB=data/jarvis.db         # sqlite path for every store
# Suppress low-priority proactive notices during these hours (24h, inclusive
# start, exclusive end). Empty or unset = never suppress.
# QUIET_HOURS=23:00-07:00
# Pin a specific pyttsx3 system voice; unset picks the platform default.
# TTS_VOICE_ID=

# Habit suggestions — nightly mining of logs/audit.jsonl into proposed profile facts
# HABIT_SCAN_HOUR=3

# Location & weather
# JARVIS wants your location so it can answer weather / "near me" without asking.
# Primary source is the Windows Location API (precise GPS, requested at HIGH
# accuracy) — turn it on at Settings > Privacy & security > Location > "Let
# desktop apps access your location". Coordinates are reverse-geocoded to a
# street-level place name via OpenStreetMap.
# Your home base: set NAME to your actual street address so "home" is always
# right regardless of where the laptop is; LAT/LON double as the GPS fallback.
# JARVIS_HOME_LAT=43.6532
# JARVIS_HOME_LON=-79.3832
# JARVIS_HOME_NAME=123 Main St, Toronto
# Units for weather (metric = °C/km·h, imperial = °F/mph). Default: metric.
# JARVIS_UNITS=metric

# Food lookup
# USDA FoodData Central API key (free: https://fdc.nal.usda.gov/api-key-signup.html).
# Unset = Open Food Facts only (branded foods); lookup still works.
# USDA_API_KEY=your-usda-fdc-api-key-here
